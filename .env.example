# Template for local environment variables.
# Copy to .env and fill in your own values. .env is gitignored and must never
# be committed. Jenkins supplies the same names via its own environment.

# HTTP port the application listens on
SERVER_PORT=8080

# Text returned by GET /hello
APP_GREETING=Hello from the DevSecOps course project!

# Placeholder only - put a real value in .env, never in the repository
APP_API_KEY=replace-me
